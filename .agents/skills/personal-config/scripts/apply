#!/usr/bin/env bash
# apply - Sync dots configs and symlinks to ~ and report what changed
set -euo pipefail

DOTS="$HOME/dots"
CHANGED=0

# Symlinks: dots is the source of truth; consumer paths write through.
# Idempotent — repairs broken/missing links, never clobbers real files.
link() {
  local target="$DOTS/$1" dst="$HOME/$2"
  [ -e "$target" ] || { echo "skip: $2 (missing $1 in dots)"; return 0; }
  if [ -L "$dst" ] && [ "$(readlink "$dst")" = "$target" ]; then return 0; fi
  if [ -e "$dst" ] && [ ! -L "$dst" ]; then
    echo "skip: $2 exists and is not a symlink — resolve manually" >&2
    return 0
  fi
  mkdir -p "$(dirname "$dst")"
  ln -sfn "$target" "$dst"
  echo "linked: $2 -> $target"
  CHANGED=$((CHANGED + 1))
}

link .agents/skills .claude/skills
link .agents/skills .agents/skills
# omp subagent definitions live inside the skill that uses them
# (.agents/skills/<skill>/agents/*.md) and are linked into ~/.omp/agent/agents
# one file at a time. That directory must be real, so retire the old
# whole-directory symlink into dots first.
AGENTS_DST="$HOME/.omp/agent/agents"
if [ -L "$AGENTS_DST" ] && [ "$(readlink "$AGENTS_DST")" = "$DOTS/.omp/agent/agents" ]; then
  rm "$AGENTS_DST"
  echo "unlinked: .omp/agent/agents (was a directory symlink)"
fi
mkdir -p "$AGENTS_DST"
for f in "$DOTS"/.agents/skills/*/agents/*.md; do
  [ -e "$f" ] || continue
  link "${f#"$DOTS"/}" ".omp/agent/agents/$(basename "$f")"
done
# Drop links into dots whose agent file was removed or renamed.
for l in "$AGENTS_DST"/*; do
  if [ -L "$l" ] && [ ! -e "$l" ] && [[ "$(readlink "$l")" == "$DOTS"/* ]]; then
    rm "$l"
    echo "pruned: .omp/agent/agents/$(basename "$l")"
    CHANGED=$((CHANGED + 1))
  fi
done
link AGENTS.md AGENTS.md

apply() {
  local src="$DOTS/$1" dst="$HOME/$2" mode="${3:-}"
  [ -f "$src" ] || return 0
  diff -q "$src" "$dst" >/dev/null 2>&1 && return 0
  mkdir -p "$(dirname "$dst")"
  # Write to a temp file and atomically rename, so a crash mid-copy can never
  # leave a truncated destination. Set perms before publishing.
  local tmp; tmp="$(mktemp "$(dirname "$dst")/.dots.XXXXXX")"
  cp "$src" "$tmp"
  [ -n "$mode" ] && chmod "$mode" "$tmp"
  mv -f "$tmp" "$dst"
  echo "applied: $2"
  CHANGED=$((CHANGED + 1))
}

apply .zshrc        .zshrc
apply .zprofile     .zprofile
apply .vimrc        .vimrc
apply .tmux.conf    .tmux.conf
apply .gitignore    .gitignore
# .gitconfig intentionally excluded: it has no [user] block.
# Manage git identity separately: git config --global user.name/user.email
apply .my.cnf       .my.cnf
apply .ssh/config   .ssh/config 600
apply .config/fd/ignore .config/fd/ignore
apply starship.toml .config/starship.toml
apply ghostty-config .config/ghostty/config

if [ $CHANGED -eq 0 ]; then
  echo "all configs up to date"
else
  echo ""
  echo "$CHANGED file(s) applied — reload your shell: source ~/.zshrc"
fi
