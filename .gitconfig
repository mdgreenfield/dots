# Identity is split across this file and two machine-local files (not in dots):
#   ~/.gitconfig.personal   supplies the personal email (default everywhere)
#   ~/.gitconfig.work       supplies the work email, applied only inside the
#                           gitdir prefixes listed below
# Either file is silently ignored if missing. See the README for setup steps.
[user]
    name = Matt Greenfield
[include]
    path = ~/.gitconfig.personal
[includeIf "gitdir:~/dd/"]
    path = ~/.gitconfig.work
[includeIf "gitdir:~/go/src/github.com/DataDog/"]
    path = ~/.gitconfig.work
# Color highlighting of output makes stuff easier to read
[color]
    branch = auto
    diff = auto
    status = auto
[color "branch"]
    current = green reverse
    local = green
    remote = yellow
[color "diff"]
    meta = yellow
    frag = magenta bold
    old = red bold
    new = green bold
[color "status"]
    added = yellow bold
    changed = red bold
    untracked = cyan
[alias]
    # The "lol" alias stands for "log one line" and
    # shows a great summary of your repo
    lol = log --oneline --graph --decorate
    unstage = reset HEAD
    co = checkout
    st = status
    aliases = !git config --get-regexp 'alias.*' | colrm 1 6 | sed 's/[ ]/ = /'
    alias = !sh -c '[ $# = 2 ] && git config --global alias.\"$1\" \"$2\" && exit 0 || echo \"usage: git alias <new alias> <original command>\" >&2 && exit 1' -

    # Delete all remote branches that have been merged. Excluding master, main, and jenkins.
    cr = !git branch -r --merged origin | grep -E '^[[:space:]]*origin' | grep -v -E 'master|main|jenkins' | cut -d'/' -f2 | xargs -n 1 -I{} git push origin :{}

    # Delete all local branches that have been merged. Excluding the current branch, master, and main.
    cl = !git branch --merged | grep -v -E '\\*|master|main' | xargs git branch -d

    ctags = !.git/hooks/ctags
    b = browse
    pr = pull-request -o
[rerere]
    enabled = true
[core]
    excludesfile = ~/.gitignore
    autocrlf = false
    pager = delta
[interactive]
    diffFilter = delta --color-only
[delta]
    navigate = true
    light = false
[diff]
    # For Github-style word diffs
    wordRegex = [^[:space:]]
    algorithm = histogram
[pull]
    rebase = true
[push]
    autoSetupRemote = true
[fetch]
    prune = true
[merge]
    conflictstyle = zdiff3
[rebase]
    autoStash = true
    autoSquash = true
[commit]
    verbose = true
[column]
    ui = auto
[branch]
    sort = -committerdate
[init]
    # Set a template directory for all git repos
    templateDir = ~/.git_template
    defaultBranch = main
[filter "trimWhitespace"]
    clean = git-stripspace
[advice]
	ignoredHook = false
[tag]
    forceSignAnnotated = false
    sort = -version:refname
[versionsort]
    suffix = -
