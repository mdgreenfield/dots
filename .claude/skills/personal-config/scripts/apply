#!/usr/bin/env bash
# apply - Copy dots configs to ~ and report what changed
set -euo pipefail

DOTS="$HOME/dots"
CHANGED=0

apply() {
  local src="$DOTS/$1" dst="$HOME/$2" mode="${3:-}"
  [ -f "$src" ] || return 0
  diff -q "$src" "$dst" >/dev/null 2>&1 && return 0
  mkdir -p "$(dirname "$dst")"
  # Write to a temp file and atomically rename, so a crash mid-copy can never
  # leave a truncated destination. Set perms before publishing.
  local tmp; tmp="$(mktemp "$(dirname "$dst")/.dots.XXXXXX")"
  cp "$src" "$tmp"
  [ -n "$mode" ] && chmod "$mode" "$tmp"
  mv -f "$tmp" "$dst"
  echo "applied: $2"
  CHANGED=$((CHANGED + 1))
}

apply .zshrc        .zshrc
apply .vimrc        .vimrc
apply .tmux.conf    .tmux.conf
apply .gitignore    .gitignore
# .gitconfig intentionally excluded: it has no [user] block.
# Manage git identity separately: git config --global user.name/user.email
apply .alacritty.toml .alacritty.toml
apply .my.cnf       .my.cnf
apply .ssh/config   .ssh/config 600
apply .config/fd/ignore .config/fd/ignore

if [ $CHANGED -eq 0 ]; then
  echo "all configs up to date"
else
  echo ""
  echo "$CHANGED file(s) applied — reload your shell: source ~/.zshrc"
fi
