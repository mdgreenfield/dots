Host github.com
  HostName github.com
  User git
  IdentityFile ~/.ssh/id_rsa
  IdentitiesOnly yes

Host *
  UseKeychain yes
  ServerAliveInterval 60
  # ControlMaster + Path set up auto usage of multiplexed network sockets for ssh.
  # ControlPersist keeps the master alive after the first session exits so
  # subsequent ssh/scp/git to the same host reuse it.
  ControlMaster auto
  ControlPath /tmp/%h_%p_%r.ssh
  ControlPersist 10m
  ExitOnForwardFailure yes
  # Default to never forwarding our ssh-agent
  ForwardAgent no

